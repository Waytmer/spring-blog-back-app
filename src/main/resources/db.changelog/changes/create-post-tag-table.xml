<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="create-post-tag-table" author="Waytmer">
        <createTable tableName="post_tag">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="post_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_post_tag_post"
                             referencedTableName="post" referencedColumnNames="id"
                             deleteCascade="false"/>
            </column>
            <column name="tag_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_post_tag_tag"
                             referencedTableName="tag" referencedColumnNames="id"
                             deleteCascade="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="post_tag"
                columnNames="post_id, tag_id"
                constraintName="uk_post_tag_post_id_tag_id"/>
    </changeSet>
</databaseChangeLog>